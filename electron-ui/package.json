{
  "name": "pyrokitty-ui",
  "version": "1.0.0",
  "description": "PyroKitty Viewer Manager - Multi-account Second Life/OpenSim launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/index.js && electron .\"",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/index.js --platform=browser --target=chrome114 --external:electron && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer/styles',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');fs.copyFileSync('src/renderer/styles/main.css','dist/renderer/styles/main.css');\"",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/index.js --platform=browser --target=chrome114 --external:electron --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "PyroKitty",
  "license": "LGPL-2.1",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.pyrokitty.viewer-manager",
    "productName": "PyroKitty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "data/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
