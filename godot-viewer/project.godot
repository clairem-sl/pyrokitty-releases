; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PyroKitty 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="PyroKitty 3D"

[rendering]

; 2x MSAA smooths jagged silhouette edges on objects at distance.
; Bump to msaa_3d=3 (8x) if performance allows; drop to 1 (2x) if needed.
; anti_aliasing/quality/msaa_3d=2

; 16x anisotropic filtering — fixes pixelated textures at oblique angles.
; Essentially free on any modern GPU.
; textures/default_filters/anisotropic_filtering_level=4

; Mobile renderer is recommended for OpenXR. It uses a simpler Vulkan path
; (no clustered lighting pass), avoids the Vulkan 1.3 feature requests that
; trigger Meta runtime warnings, and handles stereo viewports more efficiently.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

[xr]

openxr/enabled=true
shaders/enabled=true
; DO NOT disable submit_depth_buffer. Without it the Meta runtime has no depth
; data for ATW (Asynchronous TimeWarp) reprojection. When a frame runs late,
; instead of warping the previous frame to match head movement it shows black.
; The far plane is 256m (not 2048m) so depth precision is good where it counts.
openxr/submit_depth_buffer=true
